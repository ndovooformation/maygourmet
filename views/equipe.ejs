<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon équipe</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- inclure le fichier navbar.ejs pur avoir la barre de navigation -->
     <%- include('navbar') -%>

    <H2>Mon équipe MayGourmet</H2>
    <div class="row">
        <% resultatEquipe.forEach((result) =>{ %>
        <div class="card">
            <img class="team-img" src="/images/photo-1740252117027-4275d3f84385.avif" alt="" srcset="">
            <div class="container">
                <h4><b><%= result.nom %> <%= result.prenom %></b></h4>
                <p><%= result.poste %></p> <br>
                <input type="button" 
                value="supprimer" onclick="supprimer('<%= result.id %>')">
            </div>
        </div>
        
        <% }); %>
    </div>
    
</body>

<script>
    function supprimer(id) {
        const routeComplete = '/api/equipe/'+ id;

        fetch(
            routeComplete, {method: "DELETE"}
        ).then(
            (reponse) => response.json()
        ).then(
            (donnee) => window.location.href = donnee.routeAccueil
        ).catch(
            (erreur) => console.log(erreur)
        )
    }
</script>
</html>